SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# AI providers: each one is enabled when its key is set. At least one is required.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Leave empty for models without reasoning, such as gpt-4o-mini.
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Used for new accounts and as the fallback when a user's provider has no analysis.
DEFAULT_AI_PROVIDER=openai
# Decides whether two reports describe the same event. Without it every article
# becomes its own story and is analyzed separately.
SUBQ_API_KEY=
# Checks package stories that look like a deal or a rename with web search and
# keeps the company changes table up to date, with ANTHROPIC_API_KEY. Empty turns
# it off. claude-haiku-5-5 was tested on 30 chosen stories: 30 right, $0.22.
CHANGE_MODEL=
# Manual mode: how often to look for sources that are due; 0 turns its fetching off.
MANUAL_CHECK_INTERVAL_MINUTES=0
# Encrypts the API keys users store; without it no model can be added. Generate with
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a backup outside the database: if it is lost, users have to enter their keys again.
# It must differ from JWT_SECRET_KEY.
USER_KEY_ENCRYPTION_KEY=
JWT_SECRET_KEY=your-random-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# News cycle interval; 0 disables it. 15 is a good value for the RSS feeds.
NEWS_FETCH_INTERVAL_MINUTES=0
# Price check for the volatility alerts; 0 disables it.
VOLATILITY_CHECK_INTERVAL_MINUTES=60
# Checks that each catalog symbol still quotes the same asset on Yahoo, and moves
# renamed assets to their new symbol; 0 disables it. 24 is a good value.
ASSET_CHECK_INTERVAL_HOURS=0
RESEND_API_KEY=
EMAIL_FROM=AI Financial Insights <onboarding@resend.dev>
