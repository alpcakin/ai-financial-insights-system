SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# AI providers: each one is enabled when its key is set. At least one is required.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Leave empty for models without reasoning, such as gpt-4o-mini.
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Used for new accounts and as the fallback when a user's provider has no analysis.
DEFAULT_AI_PROVIDER=openai
JWT_SECRET_KEY=your-random-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# News cycle interval; 0 disables it. 15 is a good value for the RSS feeds.
NEWS_FETCH_INTERVAL_MINUTES=0
# Price check for the >= 7% volatility alerts; 0 disables it.
VOLATILITY_CHECK_INTERVAL_MINUTES=60
RESEND_API_KEY=
EMAIL_FROM=AI Financial Insights <onboarding@resend.dev>
