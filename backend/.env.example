SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# AI providers: each one is enabled when its key is set. At least one is required.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
GROK_MODEL=grok-3-mini
# Used for new accounts and as the fallback when a user's provider has no analysis.
DEFAULT_AI_PROVIDER=openai
MEDIASTACK_API_KEY=your-mediastack-api-key
JWT_SECRET_KEY=your-random-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
NEWS_FETCH_INTERVAL_MINUTES=0
MEDIASTACK_PAGE_SIZE=50
RESEND_API_KEY=
EMAIL_FROM=AI Financial Insights <onboarding@resend.dev>
